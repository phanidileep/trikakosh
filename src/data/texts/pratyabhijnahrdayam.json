  "verses": [
    {
      "id": "PH.1",
      "kind": "Verse",
      "textId": "PH",
      "verseNumber": 1,
      "subDivision": "Pratyabhijñā Sūtras (1–20)",
      "devanagari": "चितिः स्वतन्त्रा विश्वसिद्धिहेतुः ॥ १ ॥",
      "iast": "citiḥ svatantrā viśvasiddhihetuḥ || 1 ||",
      "padaccheda": [
        {
          "wordDevanagari": "चितिः",
          "wordIast": "citiḥ",
          "grammaticalRole": "nom. sg. f.",
          "literalMeaning": "Universal creative Consciousness"
        },
        {
          "wordDevanagari": "स्वतन्त्रा",
          "wordIast": "svatantrā",
          "grammaticalRole": "nom. sg. f.",
          "literalMeaning": "supremely autonomous / sovereignly free"
        },
        {
          "wordDevanagari": "विश्व-सिद्धि-हेतुः",
          "wordIast": "viśva-siddhi-hetuḥ",
          "grammaticalRole": "nom. sg. m. (comp.)",
          "literalMeaning": "the cause of the manifestation and realization of the universe"
        }
      ],
      "studyGloss": "Universal Consciousness, sovereignly autonomous, is the cause of the manifestation and realization of the cosmos.",
      "practicalContext": "The foundational declaration of Kashmir Shaivism: Consciousness is not an abstract blank witness, but an actively creative, sovereign power (Svātantrya) that brings forth reality.",
      "provenance": {
        "source": "GRETIL DSO Sanskrit Archive (ksemaraja_pratyabhijnahrdaya.md)",
