          "wordIast": "tat",
          "grammaticalRole": "nom. sg. n.",
          "literalMeaning": "That (manifest universe)"
        },
        {
          "wordDevanagari": "नाना",
          "wordIast": "nānā",
          "grammaticalRole": "indecl.",
          "literalMeaning": "manifold / diverse"
        },
        {
          "wordDevanagari": "अनुरूप-ग्राह्य-ग्राहक-भेदात्",
          "wordIast": "anurūpa-grāhya-grāhaka-bhedāt",
