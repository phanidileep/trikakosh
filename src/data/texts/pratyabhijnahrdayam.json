    {
      "id": "PH.2",
      "kind": "Verse",
      "textId": "PH",
      "verseNumber": 2,
      "subDivision": "Pratyabhijñā Sūtras (1–20)",
      "devanagari": "स्वेच्छया स्वभित्तौ विश्वमुन्मीलयति ॥ २ ॥",
      "iast": "svecchayā svabhittau viśvam unmīlayati || 2 ||",
      "padaccheda": [
        {
          "wordDevanagari": "स्वेच्छया",
          "wordIast": "sva-icchayā",
          "grammaticalRole": "inst. sg. f.",
          "literalMeaning": "by Her own sovereign Will"
        },
        {
          "wordDevanagari": "स्वभित्तौ",
          "wordIast": "sva-bhittau",
          "grammaticalRole": "loc. sg. f.",
          "literalMeaning": "upon Her own screen / canvas / backdrop"
        },
        {
          "wordDevanagari": "विश्वम्",
          "wordIast": "viśvam",
          "grammaticalRole": "acc. sg. n.",
          "literalMeaning": "the entire cosmos"
        },
        {
          "wordDevanagari": "उन्मीलयति",
          "wordIast": "unmīlayati",
          "grammaticalRole": "3rd sg. pres. act.",
          "literalMeaning": "flashes open / unfolds like a painted canvas"
        }
      ],
      "studyGloss": "By Her own free will, upon the screen of Her own being, She unfolds the universe.",
      "practicalContext": "Refutes the need for external matter (Prakṛti) or independent atoms. Just as an artist paints upon a canvas, Consciousness paints the world upon itself, remaining unchanged.",
