    {
      "id": "PH.5",
      "kind": "Verse",
      "textId": "PH",
      "verseNumber": 5,
      "subDivision": "Pratyabhijñā Sūtras (1–20)",
      "devanagari": "चितिरेव चेतनपदादवरूढा चेत्यसङ्कोचिनी चित्तम् ॥ ५ ॥",
      "iast": "citir eva cetanapadād avarūḍhā cetyasaṅkocinī cittam || 5 ||",
      "padaccheda": [
        {
          "wordDevanagari": "चितिः",
          "wordIast": "citiḥ",
          "grammaticalRole": "nom. sg. f.",
          "literalMeaning": "Universal Consciousness"
        },
        {
          "wordDevanagari": "एव",
          "wordIast": "eva",
          "grammaticalRole": "indecl.",
          "literalMeaning": "indeed / alone"
        },
        {
          "wordDevanagari": "चेतन-पदात्",
          "wordIast": "cetana-padāt",
          "grammaticalRole": "abl. sg. n.",
          "literalMeaning": "from the state of uncontracted sentience"
        },
        {
          "wordDevanagari": "अवरूढा",
          "wordIast": "avarūḍhā",
          "grammaticalRole": "nom. sg. f. (ppp.)",
          "literalMeaning": "descending / stepping down"
        },
        {
          "wordDevanagari": "चेत्य-सङ्कोचिनी",
          "wordIast": "cetya-saṅkocinī",
          "grammaticalRole": "nom. sg. f.",
          "literalMeaning": "contracted by the objects of perception"
        },
        {
          "wordDevanagari": "चित्तम्",
          "wordIast": "cittam",
          "grammaticalRole": "nom. sg. n.",
          "literalMeaning": "the individual mind"
        }
      ],
      "studyGloss": "Universal Consciousness itself, descending from its state of pure sentience and contracting in accordance with perceived objects, becomes the mind.",
      "practicalContext": "Mind is not a distinct mechanical substance or enemy to be destroyed; it is God's own consciousness operating in a focused, contracted register.",
