    {
      "id": "PH.4",
      "kind": "Verse",
      "textId": "PH",
      "verseNumber": 4,
      "subDivision": "Pratyabhijñā Sūtras (1–20)",
      "devanagari": "चितिसङ्कोचात्मा चेतनोऽपि सङ्कुचितविश्वमयः ॥ ४ ॥",
      "iast": "citisaṅkocātmā cetano'pi saṅkucitaviśvamayaḥ || 4 ||",
      "padaccheda": [
        {
          "wordDevanagari": "चिति-सङ्कोच-आत्मा",
          "wordIast": "citi-saṅkoca-ātmā",
          "grammaticalRole": "nom. sg. m. (comp.)",
          "literalMeaning": "having the nature of contracted Consciousness"
        },
        {
          "wordDevanagari": "चेतनः",
          "wordIast": "cetanaḥ",
          "grammaticalRole": "nom. sg. m.",
          "literalMeaning": "the individual conscious being"
        },
        {
          "wordDevanagari": "अपि",
          "wordIast": "api",
          "grammaticalRole": "indecl.",
          "literalMeaning": "even / also"
        },
        {
          "wordDevanagari": "सङ्कुचित-विश्व-मयः",
          "wordIast": "saṅkucita-viśva-mayaḥ",
          "grammaticalRole": "nom. sg. m. (comp.)",
          "literalMeaning": "composed of the universe in a contracted form"
        }
      ],
      "studyGloss": "The individual sentient being, who is a contracted form of Universal Consciousness, is also in reality the entire universe in microcosm.",
      "practicalContext": "The individual (Aṇu) is not separate from the Infinite; it is the entire cosmic ocean contracted into a single focal drop.",
